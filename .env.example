# ============================================================
# 后端 prod 模式环境变量模板
# 用法: cp .env.example .env && 按需修改值
# 注意: .env 不入库(见 .gitignore), 切勿提交真实密钥
# ============================================================

# ---- 数据库(宿主机本地 MySQL) ----
ITOPS_DB_USER=root
ITOPS_DB_PASSWORD=123456

# ---- JWT 密钥(必须 >=64 字节随机串, 禁止与 dev 默认值相同) ----
# 生成命令: openssl rand -base64 96 | tr -d '\n'
ITOPS_JWT_SECRET=please-replace-with-random-64-plus-bytes-secret-string-do-not-use-dev-default

# ---- JWT 过期(分钟, 默认 720=12h) ----
ITOPS_JWT_EXPIRE_MINUTES=720

# ---- 文件上传目录(容器内, 与 docker-compose volumes 对应) ----
ITOPS_UPLOAD_PATH=/data/uploads

# ---- 跨域白名单(逗号分隔; 公网 H5/小程序域名) ----
ITOPS_CORS_ORIGINS=https://itops.jsfqal.cn

# ---- 前端入口(用于导出 Excel 内嵌链接/二维码等) ----
ITOPS_WEB_URL=https://itops.jsfqal.cn
ITOPS_H5_URL=https://itops.jsfqal.cn/mobile

# ---- 字体文件路径(导出 Excel 时使用, 容器内默认系统字体) ----
ITOPS_FONT_PATH=/usr/lib/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ---- Hikari 连接池大小 ----
ITOPS_DB_POOL_MAX=20

# ---- 登录防爆破(同 IP+账号 失败次数上限, 锁定 10 分钟) ----
ITOPS_LOGIN_MAX_FAIL=5
