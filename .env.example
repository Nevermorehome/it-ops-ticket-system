# ============================================================
# IT 运维工单系统 - prod 模式环境变量模板
# 用法: cp .env.example .env && 按需修改值
# 注意: .env 不入库(见 .gitignore), 切勿提交真实密钥到 git
#
# Linux 服务器快速部署:
#   1. 安装 Docker + docker compose 插件
#   2. 准备宿主机本地 MySQL 8 (root 账号 + itops 库, 初始化脚本见 deploy/sql/)
#   3. curl -O https://raw.githubusercontent.com/Nevermorehome/it-ops-ticket-system/main/docker-compose.yml
#   4. cp .env.example .env 并按下文修改(至少改 DB_PASSWORD / JWT_SECRET / CORS_ORIGINS)
#   5. docker compose pull && docker compose up -d
#   6. 验证: curl http://localhost:8080/actuator/health 应返回 {"status":"UP"}
# ============================================================

# ---- 数据库(宿主机本地 MySQL, 容器经 host.docker.internal:3306 访问) ----
ITOPS_DB_USER=root
ITOPS_DB_PASSWORD=123456

# ---- JWT 密钥(必须 >=64 字节随机串, 禁止与 dev 默认值相同, 否则 prod 拒绝启动) ----
# 生成命令(Linux):   openssl rand -base64 96 | tr -d '\n'
# 生成命令(Windows PowerShell):
#   $b=New-Object byte[] 96; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ITOPS_JWT_SECRET=please-replace-with-random-64-plus-bytes-secret-string-do-not-use-dev-default

# ---- JWT 过期(分钟, 默认 720=12h) ----
ITOPS_JWT_EXPIRE_MINUTES=720

# ---- 文件上传目录(容器内路径, 与 docker-compose volumes 映射对应, 勿改) ----
ITOPS_UPLOAD_PATH=/data/uploads

# ---- 跨域白名单(逗号分隔) ----
# 重要: 浏览器同源 POST 也会带 Origin 头, 白名单必须包含【所有实际访问入口】, 否则
#       CorsFilter 会在 controller 之前返回 403, 前端显示"没有操作权限"!
# 必须列出: 本机/局域网/公网域名 全部入口, 例如:
#   http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173,https://ops.example.com
ITOPS_CORS_ORIGINS=https://itops.jsfqal.cn,http://localhost:5173,http://127.0.0.1:5173

# ---- 前端入口地址(用于导出 Excel 内嵌链接/消息跳转链接等) ----
ITOPS_WEB_URL=https://itops.jsfqal.cn
ITOPS_H5_URL=https://itops.jsfqal.cn/mobile

# ---- 字体文件路径(导出 Excel 中文用, 容器内已装 Noto CJK, 勿改) ----
ITOPS_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ---- Hikari 连接池最大连接数 ----
ITOPS_DB_POOL_MAX=20

# ---- 登录防爆破: 同 IP+账号 连续失败上限 / 锁定时长(分钟) ----
ITOPS_LOGIN_MAX_FAIL=5
ITOPS_LOGIN_LOCK_MINUTES=10
