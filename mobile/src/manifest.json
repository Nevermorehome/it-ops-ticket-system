  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false
    },
    "usingComponents": true
  },
  "h5": {
    "title": "IT运维工单",
    "router": {
      "mode": "history",
      "base": "/mobile/"
    },
    "devServer": {
      "port": 5174
    }
  },
  "vueVersion": "3"
}
